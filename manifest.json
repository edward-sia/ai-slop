{
  "manifest_version": 3,
  "name": "AI Slop Detector (Local)",
  "version": "1.1",
  "description": "Uses a local Ollama model to flag low-information filler text on the pages you read.",
  "permissions": [],
  "host_permissions": [
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "slop.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
